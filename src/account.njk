---
layout: base.njk
title: Your account | Through Northumberland
description: Manage your Through Northumberland account and saved places.
permalink: /account/
---

<section class="account-page">

    <div class="account-container">

        <div class="account-card">

            <!-- ACCOUNT HEADER -->

<div class="account-brand">

    <span class="eyebrow">
        YOUR ACCOUNT
    </span>

    <h1>Welcome back.</h1>

    <p id="account-email">
        Loading your account...
    </p>

</div>

            <!-- ACCOUNT SUMMARY -->

<div
    class="account-summary"
    id="account-summary"
>

    <div class="account-stat">

        <strong id="saved-count">
            0
        </strong>

        <span>
            Saved places
        </span>

    </div>


    <div class="account-stat">

        <strong id="category-count">
            0
        </strong>

        <span id="category-label">
            Categories
        </span>

        <small
            id="category-list"
            class="account-category-list"
        ></small>

    </div>

</div>

<!-- ACCOUNT SECTIONS -->

<div class="account-tabs">

    <button
        type="button"
        class="account-tab account-tab-active"
        data-account-tab="saved"
    >
        Saved places
    </button>

    <button
        type="button"
        class="account-tab"
        data-account-tab="suggestions"
    >
        Suggestions
    </button>

</div>

            <!-- FAVOURITES -->

            <div class="account-saved account-section-active" data-account-section="saved">

                <div class="account-saved-heading">

                    <span class="eyebrow">
                        YOUR FAVOURITES
                    </span>

                    <h2>Saved places</h2>

                    <p>
                        The places you've saved to explore later.
                    </p>

                </div>


                <div
                    class="account-saved-grid"
                    id="saved-places"
                >

                    <p class="account-saved-loading">
                        Loading your saved places...
                    </p>

                </div>

            </div>
<!-- SUGGESTIONS -->

<div class="account-suggestions" data-account-section="suggestions">

    <div class="account-saved-heading">

        <span class="eyebrow">
            YOUR SUGGESTIONS
        </span>

        <h2>Suggested places</h2>

        <p>
            Places you've suggested to Through Northumberland.
        </p>

    </div>

    <div
        class="account-suggestions-list"
        id="account-suggestions"
    >

        <p class="account-saved-loading">
            Loading your suggestions...
        </p>

    </div>

</div>

        </div>

    </div>

</section>


<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="/assets/js/supabase-client.js"></script>


<script>

async function loadAccount() {

    const {
        data: {
            user
        }
    } = await window.tnSupabase.auth.getUser();


    if (!user) {

        window.location.href = "/login/";

        return;

    }


    document.getElementById("account-email").textContent =
        user.email;


    loadSavedPlaces(user);
    loadSuggestions(user);

}


async function loadSavedPlaces(user) {

    const savedPlaces =
        document.getElementById("saved-places");


    const {
        data,
        error
    } = await window.tnSupabase
        .from("favourites")
        .select(`
            place_id,
            created_at,
            places (
                title,
                slug,
                image,
                category
            )
        `)
        .eq("user_id", user.id)
        .order("created_at", {
            ascending: false
        });


    if (error) {

        savedPlaces.innerHTML = `
            <p class="account-saved-empty">
                Unable to load your saved places.
            </p>
        `;

        return;

    }


    const favourites =
        data || [];


    /* -----------------------------------------
       ACCOUNT STATS
       ----------------------------------------- */

    document.getElementById("saved-count").textContent =
        favourites.length;


    const categories =
        new Set(
            favourites
                .map(function (favourite) {
                    return favourite.places &&
                        favourite.places.category;
                })
                .filter(Boolean)
        );


    document.getElementById("category-count").textContent =
    categories.size;

document.getElementById("category-label").textContent =
    categories.size === 1 ? "Category" : "Categories";

document.getElementById("category-list").textContent =
    Array.from(categories).join(" · ");


    /* -----------------------------------------
       EMPTY STATE
       ----------------------------------------- */

    if (favourites.length === 0) {

        savedPlaces.innerHTML = `
            <div class="account-saved-empty">
                <h3>No saved places yet.</h3>

                <p>
                    Explore Northumberland and save places
                    you'd like to come back to.
                </p>

                <a href="/explore/">
                    Start exploring →
                </a>
            </div>
        `;

        return;

    }


    /* -----------------------------------------
       SAVED PLACE CARDS
       ----------------------------------------- */

    savedPlaces.innerHTML =
        favourites.map(function (favourite) {

            const place =
                favourite.places;


            if (!place) {
                return "";
            }


            return `
                <article
                    class="account-saved-card"
                    data-place-id="${favourite.place_id}"
                >

                    <a
                        href="/places/${place.slug}/"
                        class="account-saved-card-link"
                    >

                        <div class="account-saved-image">

                            <img
                                src="${place.image || ""}"
                                alt="${place.title}"
                                loading="lazy"
                            >

                                        <button
                type="button"
                class="account-saved-heart"
                data-place-id="${favourite.place_id}"
                aria-label="Remove ${place.title} from favourites"
            >
                ♥
            </button>

                        </div>


                        <div class="account-saved-content">

                            <span class="eyebrow">
                                ${place.category || "PLACE"}
                            </span>

                            <h3>
                                ${place.title}
                            </h3>

                            <span class="account-saved-link">
                                View place →
                            </span>

                        </div>

                    </a>

                </article>
            `;

        }).join("");

}

async function loadSuggestions(user) {

    const suggestionsElement =
        document.getElementById("account-suggestions");

    const {
        data,
        error
    } = await window.tnSupabase
        .from("place_suggestions")
        .select(`
            id,
            title,
            type,
            description,
            status,
            created_at
        `)
        .eq("user_id", user.id)
        .order("created_at", {
            ascending: false
        });

    if (error) {

        suggestionsElement.innerHTML = `
            <p class="account-saved-empty">
                Unable to load your suggestions.
            </p>
        `;

        return;
    }

    const suggestions = data || [];

    if (suggestions.length === 0) {

        suggestionsElement.innerHTML = `
            <div class="account-saved-empty">
                <h3>No suggestions yet.</h3>

                <p>
                    Know somewhere worth adding?
                </p>

                <a href="/suggest-place/">
                    Suggest a place →
                </a>
            </div>
        `;

        return;
    }

    suggestionsElement.innerHTML =
        suggestions.map(function (suggestion) {

            let statusLabel = "Under review";
            let statusClass = "pending";

            if (suggestion.status === "approved") {
                statusLabel = "Added";
                statusClass = "approved";
            }

            if (suggestion.status === "rejected") {
                statusLabel = "Rejected";
                statusClass = "rejected";
            }

            const date =
                new Date(suggestion.created_at)
                    .toLocaleDateString(
                        "en-GB",
                        {
                            day: "numeric",
                            month: "short",
                            year: "numeric"
                        }
                    );

return `
    <div
        class="account-suggestion"
        data-suggestion-id="${suggestion.id}"
    >

        <div class="account-suggestion-content">

            <span class="eyebrow">
                ${suggestion.type || "PLACE"}
            </span>

            <h3>
                ${suggestion.title}
            </h3>

            <p>
                Suggested ${date}
            </p>

        </div>

        <div class="account-suggestion-actions">

            <span
                class="account-suggestion-status ${statusClass}"
            >
                ${statusLabel}
            </span>

            <button
                type="button"
                class="account-suggestion-delete"
                data-suggestion-id="${suggestion.id}"
            >
                Delete
            </button>

        </div>

    </div>
`;

        }).join("");
}


/* -----------------------------------------
   REMOVE FAVOURITE FROM ACCOUNT
   ----------------------------------------- */

document.addEventListener("click", async function (event) {

    const button =
        event.target.closest(".account-saved-heart");

    if (!button) return;

    event.preventDefault();
    event.stopPropagation();

    const placeId =
        Number(button.dataset.placeId);

    if (!placeId) return;


    button.disabled = true;


    const {
        error
    } = await window.tnSupabase
        .from("favourites")
        .delete()
        .eq("user_id", (
            await window.tnSupabase.auth.getUser()
        ).data.user.id)
        .eq("place_id", placeId);


    if (!error) {

        const card =
            button.closest(".account-saved-card");

        if (card) {
            card.remove();
        }


        /* Update saved count */

        const savedCount =
            document.getElementById("saved-count");

if (savedCount) {

    const currentCount =
        Number(savedCount.textContent) || 0;

    savedCount.textContent =
        Math.max(0, currentCount - 1);

}


/* Update category summary */

const remainingCards =
    document.querySelectorAll(".account-saved-card");


const remainingCategories =
    new Set();


remainingCards.forEach(function (card) {

    const category =
        card.querySelector(".eyebrow");

    if (category && category.textContent.trim()) {

        remainingCategories.add(
            category.textContent.trim()
        );

    }

});


const categoryCount =
    document.getElementById("category-count");

const categoryLabel =
    document.getElementById("category-label");

const categoryList =
    document.getElementById("category-list");


if (categoryCount) {

    categoryCount.textContent =
        remainingCategories.size;

}


if (categoryLabel) {

    categoryLabel.textContent =
        remainingCategories.size === 1
            ? "Category"
            : "Categories";

}


if (categoryList) {

    categoryList.textContent =
        Array.from(remainingCategories).join(" · ");

}

    }


    button.disabled = false;

});

document.addEventListener("click", async function (event) {

    const button =
        event.target.closest(".account-suggestion-delete");

    if (!button) return;

    const suggestionId =
        Number(button.dataset.suggestionId);

    if (!suggestionId) return;

    const confirmed =
        window.confirm(
            "Are you sure you want to delete this suggestion?"
        );

    if (!confirmed) return;

    button.disabled = true;
    button.textContent = "Deleting...";

    const {
        data: {
            user
        }
    } = await window.tnSupabase.auth.getUser();

    if (!user) {
        window.location.href = "/login/";
        return;
    }

    const {
        error
    } = await window.tnSupabase
        .from("place_suggestions")
        .delete()
        .eq("id", suggestionId)
        .eq("user_id", user.id);

    if (error) {

        console.error(
            "Suggestion delete error:",
            error
        );

        button.disabled = false;
        button.textContent = "Delete";

        return;
    }

    const suggestion =
        button.closest(".account-suggestion");

    if (suggestion) {
        suggestion.remove();
    }

});

document
    .querySelectorAll(".account-tab")
    .forEach(function (tab) {

        tab.addEventListener("click", function () {

            const selected =
                tab.dataset.accountTab;


            document
                .querySelectorAll(".account-tab")
                .forEach(function (item) {

                    item.classList.remove(
                        "account-tab-active"
                    );

                });


            tab.classList.add(
                "account-tab-active"
            );


document
    .querySelectorAll("[data-account-section]")
    .forEach(function (section) {

        if (section.dataset.accountSection === selected) {
            section.classList.add("account-section-visible");
        } else {
            section.classList.remove("account-section-visible");
        }

    });

        });

    });


document
    .querySelectorAll("[data-account-section]")
    .forEach(function (section) {

        if (section.dataset.accountSection === "saved") {
            section.classList.add("account-section-visible");
        } else {
            section.classList.remove("account-section-visible");
        }

    });
loadAccount();


document
    .getElementById("logout-button")
    .addEventListener("click", async function () {

        await window.tnSupabase.auth.signOut();

        window.location.href = "/login/";

    });

</script>