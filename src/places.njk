---
layout: base.njk
title: Places in Northumberland
description: Explore towns, villages, coastal communities and historic places across Northumberland.
permalink: /places/
---
        <!-- PAGE INTRO -->

        <section class="places-hero">

            <div class="container">

                <div class="places-hero-content">

                    <p class="eyebrow">
                        EXPLORE NORTHUMBERLAND
                    </p>

                    <h1>
                        Places worth
                        <span>getting to know.</span>
                    </h1>

                    <p class="places-hero-intro">
                        From historic castles and coastal villages to
                        beautiful market towns and quiet countryside,
                        discover some of the places that make Northumberland special.
                    </p>

                </div>

            </div>

        </section>



        <!-- FILTERS -->

        <section class="places-filters">

            <div class="container">

                <div class="filter-list">

                    <div class="filter-list">

                        <button class="filter-button active" data-filter="all">
                            All places
                        </button>

                        <button class="filter-button" data-filter="Coast">
                            Coast
                        </button>

                        <button class="filter-button" data-filter="Towns">
                            Towns
                        </button>

                        <button class="filter-button" data-filter="Villages">
                            Villages
                        </button>

                        <button class="filter-button" data-filter="Historic">
                            Historic
                        </button>

                        <button class="filter-button" data-filter="Countryside">
                            Countryside
                        </button>

                    </div>

                </div>

            </div>

        </section>



        <!-- PLACES -->

        <section class="places-list">

            <div class="container">

                <div class="places-grid">

                    {% for key, place in places %}
                        {% if place.status == "published" %}
                            <article 
                                class="places-card"
                                data-category="{{ place.category }}"
                         >

                                <a href="/places/{{ key }}/" class="places-card-link">

                                    <div class="places-card-image">

                                        <img
                                            src="{{ place.image }}"
                                            alt="{{ place.title }}"
                                        >

                                        <button
                                            class="save-button"
                                            type="button"
                                            aria-label="Save {{ place.title }}"
                                        >
                                            ♡
                                        </button>

                                    </div>

                                    <div class="places-card-content">

                                        <div class="places-card-meta">
                                            <span>{{ place.category }}</span>
                                            <span>★★★★★</span>
                                        </div>

                                        <h2>{{ place.title }}</h2>

                                        <p>
                                            {{ place.intro }}
                                        </p>

                                    </div>

                                </a>

                            </article>
                        {% endif %}
                    {% endfor %}

                </div>

            </div>

        </section>
<script src="/assets/js/places-filters.js"></script>     
